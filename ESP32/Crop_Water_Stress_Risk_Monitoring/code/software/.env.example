# Public URLs. Replace these when your domain is ready; do not hard-code them.
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=

# PostgreSQL (the Docker default is intentionally local only)
DATABASE_URL=postgresql://cws:cws-development-only@localhost:5432/cws?schema=public

# Backend MQTT service identity. Devices receive separate per-device credentials.
MQTT_BROKER_URL=mqtts://broker.example.invalid:8883
MQTT_USERNAME=backend-service
MQTT_PASSWORD=replace-before-use
# Supply exactly one CA option for TLS brokers.
MQTT_CA_PATH=
MQTT_CA_PEM=

# Use high-entropy random values in staging/production (minimum 32 characters).
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Optional services
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Optional weather context. The device remains the source of farm measurements.
# Use your farm's coordinates; Open-Meteo requires no API key for eligible usage.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
