{
  "name": "@cws/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@prisma/client": "^6.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.41.1",
    "fastify": "^5.12.7",
    "dotenv": "^16.4.7",
    "mqtt": "^5.10.2",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": { "@types/node": "^22.10.1", "prisma": "^6.1.0", "typescript": "^5.7.2" }
}
