{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "message_type": {
      "const": "capabilities"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1,
      "maxLength": 79
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1,
      "maxLength": 79
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "time": {
      "type": "object",
      "properties": {
        "uptime_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "synchronized": {
          "type": "boolean"
        },
        "unix_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1700000000
        }
      },
      "required": [
        "uptime_ms",
        "synchronized",
        "unix_s"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "enum": [
              "device.get_info",
              "device.get_status",
              "device.get_health",
              "device.get_capabilities",
              "device.reboot",
              "device.factory_reset",
              "device.clear_recoverable_faults",
              "device.get_diagnostics",
              "device.sync_time",
              "config.get",
              "config.validate",
              "config.patch",
              "config.restore_defaults",
              "config.get_revision",
              "config.export",
              "environment.read_now",
              "environment.get_status",
              "environment.get_config",
              "environment.set_offsets",
              "environment.reset_offsets",
              "environment.enable",
              "environment.disable",
              "soil.read_now",
              "soil.get_status",
              "soil.get_calibration",
              "soil.capture_dry",
              "soil.capture_wet",
              "soil.set_calibration",
              "soil.validate_calibration",
              "soil.reset_calibration",
              "soil.enable",
              "soil.disable",
              "battery.read_now",
              "battery.get_status",
              "battery.get_calibration",
              "battery.capture_reference",
              "battery.set_calibration",
              "battery.reset_calibration",
              "battery.set_thresholds",
              "solar.read_now",
              "solar.get_status",
              "solar.get_calibration",
              "solar.capture_reference",
              "solar.set_calibration",
              "solar.reset_calibration",
              "solar.set_thresholds",
              "lcd.get_status",
              "lcd.set_backlight",
              "lcd.set_timeout",
              "lcd.set_page",
              "lcd.set_enabled",
              "lcd.show_notice",
              "led.get_status",
              "led.set_enabled",
              "led.set_preferences",
              "led.test",
              "led.reset_preferences",
              "buzzer.get_status",
              "buzzer.set_enabled",
              "buzzer.set_alert_preferences",
              "buzzer.mute",
              "buzzer.unmute",
              "buzzer.test",
              "buzzer.stop",
              "wifi.get_status",
              "wifi.scan",
              "wifi.configure",
              "wifi.test_connection",
              "wifi.reconnect",
              "wifi.disconnect",
              "wifi.forget_network",
              "mqtt.get_status",
              "mqtt.configure",
              "mqtt.test_connection",
              "mqtt.reconnect",
              "mqtt.get_config",
              "telemetry.read_now",
              "telemetry.get_last",
              "telemetry.get_history",
              "telemetry.publish_now",
              "telemetry.set_intervals",
              "telemetry.get_delivery_status",
              "telemetry.retry_pending",
              "storage.get_status",
              "storage.get_statistics",
              "storage.get_pending_count",
              "storage.export_records",
              "storage.retry_sync",
              "storage.set_retention",
              "storage.purge_acknowledged",
              "diagnostics.get_faults",
              "diagnostics.get_logs",
              "diagnostics.self_test",
              "diagnostics.get_memory",
              "diagnostics.get_reset_reason",
              "firmware.get_version",
              "firmware.get_update_status"
            ]
          },
          "uniqueItems": true
        },
        "command_authorization": {
          "type": "string",
          "maxLength": 128
        },
        "mutations_require_expected_revision": {
          "const": true
        },
        "max_command_lifetime_s": {
          "const": 300
        },
        "headless": {
          "const": true
        },
        "lcd_present": {
          "type": "boolean"
        },
        "encoder_enabled": {
          "type": "boolean"
        },
        "tls_required": {
          "const": true
        },
        "mqtt_qos": {
          "const": 1
        },
        "durable_ack_enabled": {
          "type": "boolean"
        },
        "ota": {
          "const": false
        },
        "vwc": {
          "const": false
        },
        "battery_percentage": {
          "const": false
        },
        "mtls": {
          "const": false
        },
        "max_message_bytes": {
          "const": 8192
        },
        "max_history_records_per_response": {
          "const": 1
        }
      },
      "required": [
        "commands",
        "command_authorization",
        "mutations_require_expected_revision",
        "max_command_lifetime_s",
        "headless",
        "lcd_present",
        "encoder_enabled",
        "tls_required",
        "mqtt_qos",
        "durable_ack_enabled",
        "ota",
        "vwc",
        "battery_percentage",
        "mtls",
        "max_message_bytes",
        "max_history_records_per_response"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "message_type",
    "message_id",
    "device_id",
    "boot_id",
    "sequence",
    "time",
    "capabilities"
  ],
  "additionalProperties": false
}
