{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 48
    },
    "site_id": {
      "type": "string",
      "maxLength": 48
    },
    "plot_id": {
      "type": "string",
      "maxLength": 48
    },
    "sample_s": {
      "type": "integer",
      "minimum": 5,
      "maximum": 86400
    },
    "upload_s": {
      "type": "integer",
      "minimum": 10,
      "maximum": 86400
    },
    "health_s": {
      "type": "integer",
      "minimum": 10,
      "maximum": 86400
    },
    "lcd": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "address": {
          "type": "integer",
          "minimum": 32,
          "maximum": 63
        },
        "backlight": {
          "type": "boolean"
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "encoder": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "led": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "active_high": {
          "type": "boolean"
        },
        "breathing": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "buzzer": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "passive": {
          "type": "boolean"
        },
        "active_high": {
          "type": "boolean"
        },
        "alerts": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "retain": {
          "type": "integer",
          "minimum": 8,
          "maximum": 256
        },
        "drop_oldest": {
          "type": "boolean"
        },
        "durable_ack": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false
}
