{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crop Water Stress Monitor dashboard telemetry",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "message_type": { "const": "telemetry" },
    "message_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 1, "maxLength": 79 },
    "device_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 1, "maxLength": 79 },
    "boot_id": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "time": {
      "type": "object",
      "properties": {
        "uptime_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "synchronized": { "type": "boolean" },
        "unix_s": { "type": ["integer", "null"], "minimum": 1700000000 }
      },
      "required": ["uptime_ms", "synchronized", "unix_s"],
      "additionalProperties": false
    },
    "firmware_version": { "type": "string", "maxLength": 32 },
    "hardware_model": { "const": "ESP32-WROOM-32U" },
    "configuration_revision": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "measurements": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "object",
          "properties": {
            "valid": { "type": "boolean" },
            "temperature_c": { "type": ["number", "null"], "minimum": -50, "maximum": 90 },
            "humidity_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
          },
          "required": ["valid", "temperature_c", "humidity_pct"],
          "additionalProperties": false
        },
        "soil": {
          "type": "object",
          "properties": {
            "valid": { "type": "boolean" },
            "relative_moisture_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
          },
          "required": ["valid", "relative_moisture_pct"],
          "additionalProperties": false
        },
        "battery": {
          "type": "object",
          "properties": {
            "valid": { "type": "boolean" },
            "voltage_v": { "type": ["number", "null"], "minimum": 0, "maximum": 1000 },
            "critical": { "type": "boolean" }
          },
          "required": ["valid", "voltage_v", "critical"],
          "additionalProperties": false
        },
        "solar": {
          "type": "object",
          "properties": {
            "valid": { "type": "boolean" },
            "voltage_v": { "type": ["number", "null"], "minimum": 0, "maximum": 1000 }
          },
          "required": ["valid", "voltage_v"],
          "additionalProperties": false
        }
      },
      "required": ["environment", "soil", "battery", "solar"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "message_type", "message_id", "device_id", "boot_id", "sequence", "time", "firmware_version", "hardware_model", "configuration_revision", "measurements"],
  "additionalProperties": false
}
