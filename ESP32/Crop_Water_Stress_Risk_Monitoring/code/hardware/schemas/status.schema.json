{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "message_type": {
      "const": "status"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1,
      "maxLength": 79
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1,
      "maxLength": 79
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "time": {
      "type": "object",
      "properties": {
        "uptime_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "synchronized": {
          "type": "boolean"
        },
        "unix_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1700000000
        }
      },
      "required": [
        "uptime_ms",
        "synchronized",
        "unix_s"
      ],
      "additionalProperties": false
    },
    "firmware_version": {
      "type": "string",
      "maxLength": 32
    },
    "build_version": {
      "type": "string",
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "maxLength": 48
    },
    "site_id": {
      "type": "string",
      "maxLength": 48
    },
    "plot_id": {
      "type": "string",
      "maxLength": 48
    },
    "hardware_model": {
      "const": "ESP32-WROOM-32U"
    },
    "configuration_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "calibration_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "connectivity": {
      "type": "object",
      "properties": {
        "wifi_connected": {
          "type": "boolean"
        },
        "ssid": {
          "type": "string",
          "maxLength": 32
        },
        "ip": {
          "type": "string",
          "maxLength": 15
        },
        "ip_assigned": {
          "type": "boolean"
        },
        "rssi_dbm": {
          "type": "integer",
          "minimum": -127,
          "maximum": 0
        },
        "mqtt_connected": {
          "type": "boolean"
        },
        "mqtt_subscribed": {
          "type": "boolean"
        },
        "tls_verified": {
          "type": "boolean"
        },
        "last_connection_error": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "reconnection_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "last_publish_acknowledged_by_broker": {
          "type": "boolean"
        },
        "dropped_inbound_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "wifi_connected",
        "ssid",
        "ip",
        "ip_assigned",
        "rssi_dbm",
        "mqtt_connected",
        "mqtt_subscribed",
        "tls_verified",
        "last_connection_error",
        "reconnection_count",
        "last_publish_acknowledged_by_broker",
        "dropped_inbound_messages"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "mounted": {
          "type": "boolean"
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "pending_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "capacity_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "capacity_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "dropped_records_since_boot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "storage_faults_since_boot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "retry_count_since_boot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "last_acknowledged_record": {
          "type": "string",
          "maxLength": 79
        },
        "oldest_pending_record": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 79
        }
      },
      "required": [
        "mounted",
        "records",
        "pending_records",
        "capacity_records",
        "capacity_bytes",
        "used_bytes",
        "dropped_records_since_boot",
        "storage_faults_since_boot",
        "retry_count_since_boot",
        "last_acknowledged_record",
        "oldest_pending_record"
      ],
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "uptime_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reset_reason": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "boot_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "free_heap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "minimum_free_heap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "flash_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "firmware_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "operating_state": {
          "type": "string",
          "maxLength": 32
        },
        "active_faults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 64
              },
              "severity": {
                "enum": [
                  "warning",
                  "critical"
                ]
              },
              "since_uptime_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "occurrences_since_boot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "required": [
              "code",
              "severity",
              "since_uptime_ms",
              "occurrences_since_boot"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "uptime_ms",
        "reset_reason",
        "boot_count",
        "free_heap",
        "minimum_free_heap",
        "flash_bytes",
        "firmware_bytes",
        "operating_state",
        "active_faults"
      ],
      "additionalProperties": false
    },
    "indicators": {
      "type": "object",
      "properties": {
        "led_on": {
          "type": "boolean"
        },
        "led_pattern": {
          "type": "string",
          "maxLength": 32
        },
        "buzzer_active": {
          "type": "boolean"
        },
        "buzzer_muted": {
          "type": "boolean"
        }
      },
      "required": [
        "led_on",
        "led_pattern",
        "buzzer_active",
        "buzzer_muted"
      ],
      "additionalProperties": false
    },
    "local_peripherals": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "encoder_enabled": {
          "type": "boolean"
        },
        "backlight": {
          "type": "boolean"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "present",
        "encoder_enabled",
        "backlight",
        "page"
      ],
      "additionalProperties": false
    },
    "setup_remaining_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "trial_state": {
      "type": "string",
      "maxLength": 64
    },
    "trial_error": {
      "type": "string",
      "maxLength": 96
    },
    "mqtt_host": {
      "type": "string",
      "maxLength": 128
    }
  },
  "required": [
    "schema_version",
    "message_type",
    "message_id",
    "device_id",
    "boot_id",
    "sequence",
    "time",
    "firmware_version",
    "build_version",
    "name",
    "site_id",
    "plot_id",
    "hardware_model",
    "configuration_revision",
    "calibration_revision",
    "connectivity",
    "storage",
    "health",
    "indicators",
    "local_peripherals",
    "setup_remaining_s",
    "trial_state",
    "trial_error",
    "mqtt_host"
  ],
  "additionalProperties": false
}
